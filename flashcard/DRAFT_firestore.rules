rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']) && isValidUser(incoming())
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is string;
    }

    // --- Projects ---
    match /projects/{projectId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidProject(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'color']) && isValidProject(incoming())
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt']) &&
             isValidId(data.id) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.createdAt is string;
    }

    // --- FlashcardSets ---
    match /flashcardSets/{setId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidFlashcardSet(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'cards', 'lastStudied', 'projectId']) && isValidFlashcardSet(incoming())
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    function isValidFlashcardSet(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'cards', 'createdAt']) &&
             isValidId(data.id) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.cards is list && data.cards.size() <= 1000 &&
             data.createdAt is string;
    }
  }
}
